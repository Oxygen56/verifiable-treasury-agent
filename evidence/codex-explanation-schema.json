{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "plainLanguageSummary",
    "requiredAuthorizations",
    "preflightRechecks",
    "stopConditions",
    "authorityStatement",
    "evidenceBoundary"
  ],
  "properties": {
    "decision": { "type": "string", "const": "UNSIGNED_REVIEW_REQUIRED" },
    "plainLanguageSummary": { "type": "string" },
    "requiredAuthorizations": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 2,
      "maxItems": 5
    },
    "preflightRechecks": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 4,
      "maxItems": 8
    },
    "stopConditions": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 3,
      "maxItems": 8
    },
    "authorityStatement": { "type": "string" },
    "evidenceBoundary": { "type": "string" }
  }
}
